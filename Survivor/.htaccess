# Hébergement IONOS (Apache). Les modules du jeu changent à chaque mise à jour : le navigateur
# revérifie avant de réutiliser son cache (remplace l'ancien netlify.toml).
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=0, must-revalidate"
</IfModule>

# Les modules ES doivent être servis comme JavaScript.
AddType text/javascript .js .mjs
# Manifeste de l'application installable (PWA). sw.js suit la règle ci-dessus : toujours revérifié,
# donc une nouvelle version du service worker est vue dès la visite suivante.
AddType application/manifest+json .webmanifest
# Référencement : llms.txt (accents), robots.txt et sitemap.xml servis en UTF-8.
AddCharset UTF-8 .txt .xml
